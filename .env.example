# Fake local development defaults only. Never use in production.
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev_password
POSTGRES_DB=freelanceos

# Fake placeholders for separate runtime and migration-owner credentials.
# Runtime URL required since BUILD 5; migration owner is never used at startup.
DATABASE_URL=postgresql://app_runtime:fake_runtime_password@postgres:5432/freelanceos
MIGRATION_DATABASE_URL=postgresql://migration_owner:fake_owner_password@postgres:5432/freelanceos

# Dedicated integration DB only; provision the restricted role before use.
TEST_DATABASE_URL=postgresql://feature2_runtime:fake_test_password@postgres:5432/freelanceos_test
TEST_MIGRATION_DATABASE_URL=postgresql://migration_owner:fake_owner_password@postgres:5432/freelanceos_test
