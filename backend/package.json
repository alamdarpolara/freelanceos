{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "start": "node dist/main.js",
    "start:dev": "npm run build && node --watch dist/main.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.ts",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.2.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "jest": "30.5.2",
    "jiti": "2.7.0",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
